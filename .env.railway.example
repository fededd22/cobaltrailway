# متغيرات اختيارية لخدمة cobalt على Railway (Service → Variables)

# يُستنتج تلقائياً من RAILWAY_PUBLIC_DOMAIN. ضعه فقط عند استخدام دومين مخصص (ينتهي بـ /)
# API_URL=https://your-domain.example/

# لا تضع PORT ولا API_PORT، Railway يحقن PORT تلقائياً.

# موصى به إذا كان الـ API عاماً
# API_AUTH_REQUIRED=1
# API_KEY_URL=...

# متغيرات الواجهة (تُدمج وقت البناء)
# WEB_HOST=your-domain.example
# WEB_ENABLE_WEBCODECS=1

# اختياري
# DURATION_LIMIT=10800
# RATELIMIT_MAX=20
# COOKIE_PATH=/cookies.json
